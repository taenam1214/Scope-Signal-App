{
  "name": "scopesignal",
  "version": "0.1.0",
  "private": true,
  "description": "ScopeSignal — AI-assisted scope-change reconciliation for commercial electrical subcontractors",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "test": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^2.121.0"
  }
}
