# =============================================================================
# ScopeSignal environment variables
# Copy to .env (and apps/web/.env.local for the web app) and fill in values.
# NEVER commit a real .env. Values marked [SERVER-ONLY] must never be exposed
# to the browser (do not prefix them with NEXT_PUBLIC_).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# For local dev these come from `supabase start` output.
# For production use the values from your Supabase project settings.
# -----------------------------------------------------------------------------
# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# [SERVER-ONLY] service role key — full DB access, bypasses RLS. Never ship to client.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# [SERVER-ONLY] direct Postgres connection string (migrations / worker):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
# [SERVER-ONLY] leave blank to use the deterministic mock AI adapter (AI_MODE=mock).
OPENAI_API_KEY=
# Model id is configured via env rather than hardcoded. Pick a current
# structured-output-capable model after checking API compatibility + pricing.
OPENAI_MODEL=gpt-4o-mini
# mock | live  — "mock" uses the offline deterministic adapter (no API calls).
AI_MODE=mock

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# [SERVER-ONLY] shared secret the web app uses to enqueue/authenticate to the worker.
WORKER_AUTH_SECRET=change-me-in-dev
# Base URL of the processor FastAPI service (server-to-server).
PROCESSOR_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | production
APP_ENV=development
# Upload limits (server-enforced). Defaults per blueprint.
MAX_UPLOAD_MB=15
MAX_PROJECT_STORAGE_MB=100
